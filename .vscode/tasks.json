// Started by the launch.json configurations; see there.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: Train SalsaNext (from SemanticKITTI)",
      "type": "shell",
      "command": "docker rm -f lero_debug >/dev/null 2>&1; docker compose run --rm --name lero_debug -p 127.0.0.1:5678:5678 seg python -Xfrozen_modules=off scripts/debug_listen.py scripts/train_salsanext.py --data ${input:data} --out outputs/salsanext --init checkpoints/salsanext_semantickitti/state_dict.pt --workers 0",
      "isBackground": true,
      "problemMatcher": {
        "owner": "debugpy",
        "pattern": {
          "regexp": "^__never_matches__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": ".",
          "endsPattern": "debugpy waiting for VS Code"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
