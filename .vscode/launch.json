// Each configuration starts its script in the lero_seg container (tasks.json) under debugpy and
// attaches to it on localhost:5678, so it works over Remote-SSH too. The SalsaNext/fusion ones load
// data in the main process (--workers 0) so breakpoints in lero_seg/*_dataset.py hit.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train SalsaNext (from SemanticKITTI)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/workspace/lero_sim_segmentation"
        }
      ],
      "justMyCode": true,
      "preLaunchTask": "docker: Train SalsaNext (from SemanticKITTI)"
    },
    {
      "name": "Train SalsaNext (1 epoch smoke test)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/workspace/lero_sim_segmentation"
        }
      ],
      "justMyCode": true,
      "preLaunchTask": "docker: Train SalsaNext (1 epoch smoke test)"
    },
    {
      "name": "Infer SalsaNext (test split)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
